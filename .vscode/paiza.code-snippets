{
	// このワークスペースでのみ有効なスニペット。
	// .vscode\ に置いた *.code-snippets は VS Code がフォルダ単位で読み込むので、
	// 他のプロジェクトには影響しない。
	"Console.ReadLine": {
		"scope": "csharp",
		"prefix": "rr",
		"body": [
			"Console.ReadLine();$0"
		],
		"description": "標準入力から1行読む"
	},
	"Console.WriteLine": {
		"scope": "csharp",
		"prefix": "ww",
		"body": [
			"Console.WriteLine($0);"
		],
		"description": "標準出力に1行書く"
	}
}
